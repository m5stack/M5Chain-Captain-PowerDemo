# ESP-IDF 5.5.5 defaults for the C160 Chain Captain L2 deep sleep power test.
CONFIG_IDF_TARGET="esp32s3"
# The L2 standby path talks to the PMIC/expander and then stops all bus traffic.
# A UART0 primary console with USB Serial/JTAG as the secondary one matches the
# configuration this state was validated with, and keeps the logs reachable over
# the USB-C port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# The vendored LVGL snapshot has no demos/ directory; its Kconfig default is y.
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_M5CC_TEST_ID="l2-deep-sleep"
CONFIG_M5CC_CONFIG_ID="l2-deep-sleep"