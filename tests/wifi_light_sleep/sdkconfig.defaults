# ESP-IDF 5.5.5 defaults for the C160 Chain Captain L3A idle power test.
CONFIG_IDF_TARGET="esp32s3"
# USB Type-C is the only console connection on the DUT, so make USB Serial/JTAG
# the primary console instead of the IDF default (UART0 + USB as secondary):
# the secondary path drops the tail of the last line before the firmware parks.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Automatic light sleep with dynamic frequency scaling.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The Wi-Fi event callback logs the assigned IPv4 address, which does not fit in
# the 2304-byte default of the default event-loop task.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# The vendored LVGL snapshot has no demos/ directory; its Kconfig default is y.
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_M5CC_TEST_ID="wifi-light-sleep"
CONFIG_M5CC_CONFIG_ID="wifi-light-sleep"

# Wi-Fi credentials stay empty in the committed defaults. Fill them in a local
# sdkconfig (never in version control) before flashing this test.
CONFIG_M5CC_WIFI_SSID=""
CONFIG_M5CC_WIFI_PASSWORD=""
CONFIG_M5CC_WIFI_TARGET_IPV4=""
CONFIG_M5CC_WIFI_LISTEN_INTERVAL=3